# Copy to .env and fill in. Used by docker compose and by scripts/start.sh.

# Postgres. In docker compose the app always talks to db:5432; these are also the DB credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trading_db
# Host-side only (scripts/start.sh, local tools): Postgres is published on 127.0.0.1:${POSTGRES_PORT}.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# API_PORT=8000

# Telegram
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=
# Your Telegram user id: the only one allowed to use /admin.
ADMIN_CHAT_ID=
# Channel for automatic posts (@name or -100...); empty turns posting off.
CHANNEL_ID=
# Optional: when api.telegram.org is reachable only through a proxy (must be reachable from containers).
# TELEGRAM_PROXY=http://host:port

# Public HTTPS address of the API (tunnel). Mini App = ${PUBLIC_URL}/miniapp.
PUBLIC_URL=https://your-name.ngrok-free.app
# Tunnel: ngrok or cloudflare.
COMPOSE_PROFILES=ngrok
NGROK_AUTHTOKEN=
# TUNNEL_TOKEN=          # cloudflare tunnel token (COMPOSE_PROFILES=cloudflare)

# scripts/start.sh (no docker for the app) reads MINIAPP_URL directly.
# MINIAPP_URL=https://your-name.ngrok-free.app/miniapp

# Optional
# CANDLE_HISTORY_DAYS=30
